# Copy to .env and replace every placeholder before deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=digital_authentication_system_das
MYSQL_USER=app_user
MYSQL_PASSWORD=replace-with-a-long-random-app-password

# Optional OTP delivery integration.
OTP_WEBHOOK_URL=https://your-trusted-service.example/otp
OTP_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
OTP_DEBUG=false
